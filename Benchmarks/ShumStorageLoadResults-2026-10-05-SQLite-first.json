  "ios": "26.6.2",
  "configuration": "Release",
  "swift_optimization": "-O whole-module-optimization",
  "enable_testability": true,
  "code_coverage": false,
  "git_branch": "main",
  "git_head": "dfcfa0e218115338c4c7524159b63a4a679cc169",
  "working_tree": "First SQLite optimization, before PeerID cache and indexed batch read receipts.",
  "host_bundle_id": "hiTeam.ShumLoadBenchmark.Shum",
  "integrity_checks": "All three cases passed: message counts, read flags, signed receipt creation, cache persistence and encrypted restoration.",
  "performance_assessment": "No multi-second interactive stalls; first projection 434ms and batch read/loaded resume 253-285ms at 10000 messages require further optimization.",
  "methodology": [
    "Separate app sandbox and temporary synthetic database; real user history was not used.",
    "Histories contain 1000, 5000, 10000 genuinely encrypted and signed text messages, about 230 Cyrillic characters each, one conversation, mixed incoming/outgoing.",
    "System SQLite with individually encrypted records; durable changed-row commits.",
    "Restore measures complete decrypt/decode with warmed filesystem caches, not total cold app launch.",
    "Network transport is simulated. Relay confirmations run immediately on MainActor, concentrating send bookkeeping and acknowledgement writes into one operation. Burst and loaded-resume peaks are conservative stress measurements, not live-network timings.",
    "A queued MainActor probe follows each synchronous operation. Its delay measures main-thread blocking, not display frame times.",
    "Burst: 20 valid new packets; outgoing read ACKs: 20 signed packets; duplicate fallback: 20 application packets, deliberately bypassing the earlier Nostr event filter.",
    "Timeline uses the production controller and SwiftUI text rows, not complete message bubbles or attachment rendering.",
    "One device run; sample counts are stored per metric. A p95 of 20 samples equals the maximum sample.",
    "Nostr cache lookup timings include assertion overhead.",
    "Release testability enabled; two legacy Debug-only suites excluded only in this benchmark build.",
    "History preparation measured on background worker with a 10ms MainActor pulse. Raw synchronous restore is diagnostic only."
  ],
  "command": "xcodebuild -xctestrun '${TEMP_ROOT}/shum-release26-load-nja2x46h/Shum_Shum_iphoneos26.2-arm64.xctestrun' -destination 'platform=iOS,id=${DEVICE_UDID}' -parallel-testing-enabled NO -only-testing:ShumTests/ShumStorageLoadTests test-without-building",
  "xcconfig": "PRODUCT_BUNDLE_IDENTIFIER = hiTeam.ShumLoadBenchmark.$(PRODUCT_NAME:rfc1034identifier)\nCODE_SIGN_ENTITLEMENTS =\nENABLE_TESTABILITY = YES\nSWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) SHUM_LOAD_TESTS\nEXCLUDED_SOURCE_FILE_NAMES = $(inherited) NostrProtocolTests.swift ShumIntegrationTests.swift\n",
